    <scriptTask id="sid-C13EDB44-CCF4-4935-B130-A3BA0AABED96" name="Setup to call connection API" scriptFormat="javascript" flowable:autoStoreVariables="false">
      <script><![CDATA[execution.setVariable('connection_headers', "accept: application/json\ncache-control: no-cache\nContent-Type: application/json\nCpd-Use-Current-User: true");

// set values to retrieve connection
var connection_id = "";
var connection_catalog_id = "";

var url = "https://cpd-internal/v2/connections/" + connection_id + "?catalog_id=" + connection_catalog_id + "&test=false&decrypt_secrets=true"

execution.setTransientVariableLocal('connection_url', url);]]></script>

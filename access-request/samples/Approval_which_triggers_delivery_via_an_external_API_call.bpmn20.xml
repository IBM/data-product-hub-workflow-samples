    <scriptTask id="sid-08CEA613-917D-4BBB-A9D0-EFDAEAB654F4" name="Retrieve credentials" scriptFormat="javascript" flowable:autoStoreVariables="false">
      <script><![CDATA[var resp_obj = JSON.parse(connection_response);
var connection_properties = resp_obj.entity.properties;

// retrieve the required credential from the above properties object and set the value in a transient execution variable
var credential = "";

execution.setTransientVariableLocal('credential', credential);]]></script>
